# Copy this file to `.env` and replace the placeholders with your own labels.
VITE_FORMSORT_CLIENT_LABEL=<client-label>
VITE_FORMSORT_FLOW_LABEL=<flow-label>
VITE_FORMSORT_VARIANT_LABEL=<variant-label>

# Optional: load this variant revision instead of the latest published one.
# You can also change it on the page.
VITE_FORMSORT_VARIANT_REVISION_UUID=
