{
  "name": "@formsort/custom-question-api",
  "version": "0.3.3",
  "description": "Helpers for implementing custom questions in Formsort",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "unpkg": "umd/custom-question-api.min.js",
  "scripts": {
    "build": "pnpm run build:package && pnpm run build:umd",
    "build:package": "tsc --project tsconfig.build.json",
    "build:umd": "vite build",
    "format": "oxfmt src && oxlint --fix src",
    "lint": "oxlint src",
    "test": "pnpm run lint",
    "pack": "pnpm pack",
    "release": "craft prepare --publish"
  },
  "files": [
    "lib/**/*",
    "umd/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formsort/oss.git"
  },
  "keywords": [
    "forms",
    "questions"
  ],
  "author": "Formsort Engineering <engineering@formsort.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/formsort/oss/issues"
  },
  "homepage": "https://github.com/formsort/oss/tree/master/packages/custom-question-api#readme",
  "devDependencies": {
    "@formsort/tsconfig": "workspace:*",
    "@types/events": "^3.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "picomatch": "^4.0.4"
  },
  "dependencies": {
    "@formsort/constants": "^1.11.0",
    "events": "^3.2.0"
  }
}
