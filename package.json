{
  "name": "root",
  "private": true,
  "engines": {
    "node": "24.14.1"
  },
  "pnpm": {
    "overrides": {
      "tslib": ">=1.10.0",
      "json5": "^2.2.3",
      "@babel/core": "^7.28.0",
      "esbuild": "^0.25.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js --cache --cache-strategy content",
    "format": "pnpm lint --fix",
    "build": "node ./scripts/build.js",
    "test": "pnpm -r run test",
    "pack": "pnpm -r run pack"
  },
  "devDependencies": {
    "@formsort/eslint-config": "workspace:^",
    "@sentry/craft": "^2.25.2",
    "eslint": "^8.12.0"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1"
}
