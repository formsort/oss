{
  "name": "root",
  "private": true,
  "engines": {
    "node": "24.14.1"
  },
  "pnpm": {
    "overrides": {
      "tslib": ">=1.10.0",
      "json5": "^2.2.3",
      "@babel/core": "^7.28.0",
      "esbuild": "^0.25.6",
      "path-to-regexp": ">=0.1.13",
      "fast-uri": ">=3.1.2",
      "qs": ">=6.14.2",
      "postcss": ">=8.5.10"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "@parcel/watcher@2.5.6"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "build": "node ./scripts/build.js",
    "test": "pnpm -r run test",
    "pack": "pnpm -r run pack"
  },
  "devDependencies": {
    "@sentry/craft": "^2.25.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1"
}
